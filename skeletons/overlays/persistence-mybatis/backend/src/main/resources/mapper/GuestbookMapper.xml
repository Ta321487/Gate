<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.thesis.mapper.GuestbookMapper">
    <select id="selectById" resultType="map">
        SELECT * FROM sys_guestbook WHERE id=#{id}
    </select>
    <select id="selectPage" resultType="map">
        SELECT * FROM sys_guestbook
        <where>
            <if test="channel != null and channel != ''">
                AND IFNULL(NULLIF(channel,''),'user')=#{channel}
            </if>
            <if test="onlyUsername != null and onlyUsername != ''">
                AND username=#{onlyUsername}
            </if>
        </where>
        ORDER BY id DESC
    </select>
</mapper>
